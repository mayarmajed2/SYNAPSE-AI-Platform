# ==============================================================================
# SYNAPSE - Environment Configuration Template (.env.example)
# ==============================================================================

# Application Settings
PROJECT_NAME=SYNAPSE
API_V1_STR=/api/v1
ENVIRONMENT=development

# Database Connection (PostgreSQL or automatic local SQLite fallback)
DATABASE_URL=postgresql+psycopg://synapse:CHANGE_ME@localhost:5433/synapse_db

# Security & Auth
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=240

# AI / LLM Providers (Configure keys and switch models dynamically)
GROQ_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Workflow & Execution Limits
MAX_RETRIES_PER_TASK=3
SANDBOX_TIMEOUT_SECONDS=30
